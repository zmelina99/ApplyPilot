# ApplyPilot — personal data template (COMMITTED; contains NO real values)
#
# Copy this file to `.env` (which is gitignored) and fill in real values there.
# The public repo never contains personal identifiers — only these placeholder keys.
# candidate.md and answers.md reference these keys.

# --- Identity ---
CANDIDATE_FULL_NAME=
CANDIDATE_PREFERRED_NAME=
CANDIDATE_PRONOUNS=
CANDIDATE_DOB=
CANDIDATE_NATIONALITY=

# --- Contact ---
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_PREFERRED_CONTACT=

# --- Location ---
CANDIDATE_CURRENT_CITY=
CANDIDATE_CURRENT_COUNTRY=
CANDIDATE_TIMEZONE=

# --- Links ---
CANDIDATE_PORTFOLIO_URL=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_PERSONAL_WEBSITE=

# --- Database (Phase 2A) ---
# Connection string for the app (local dev or managed prod). Never commit real creds.
# With the provided docker-compose: postgres://applypilot:applypilot@localhost:5432/applypilot_dev
DATABASE_URL=
# Separate database for the test suite. Tests refuse to run without it and must
# never point at the dev database.
TEST_DATABASE_URL=
